{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1
    }
  },
  "display": {
    "separator": " 󰅂 ",
    "color": {
      "keys": "magenta",
      "title": "blue"
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "---------------------------------------"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "󱎫 Uptime",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "󰨇 WM",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "󰞍 Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "󰘚 Memory",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
